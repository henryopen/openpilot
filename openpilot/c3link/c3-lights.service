[Unit]
Description=C3 traffic lights: ft1n finder (yolo26n, C3-trained, GPU from compile_lights_gpu.py, else CPU) + lightcls colour -> /dev/shm/c3det
After=c3-camerad.service c3calib.service
Wants=c3-camerad.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=comma
WorkingDirectory=/data/c3link
Environment=PYTHONPATH=/data/openpilot
Environment=C3_THREADS=4
ExecStart=/usr/local/pyenv/versions/3.11.4/bin/python /data/c3link/c3lights.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

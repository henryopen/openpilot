[Unit]
Description=C3 standalone sensord (gyro / accelerometer for c3calib, no openpilot)
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=comma
WorkingDirectory=/data/openpilot/system/sensord
# 10/23 a whole boot came up with sensord alive but reading nothing ("poll timed out"); a later start was fine.
# Start it a little after boot, and c3calib restarts it if the accelerometer still goes quiet.
ExecStartPre=/bin/sleep 15
ExecStart=/data/openpilot/system/sensord/sensord
Restart=always
RestartSec=5
LimitRTPRIO=99
LimitNICE=-20
AmbientCapabilities=CAP_SYS_NICE

[Install]
WantedBy=multi-user.target

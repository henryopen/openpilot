[Unit]
Description=Start the car's hotspot when there is no known wifi, so the HUD Pi can join
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
# nmcli con up needs root; everything it touches is NetworkManager's own state
User=root
# openpilot's python, to read the panda's harness status (pandaStates) - in the car or not decides the network
Environment=PYTHONPATH=/data/openpilot
ExecStart=/usr/local/venv/bin/python /data/openpilot/openpilot/hud/car_hotspot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
